{
  "name": "dsh-chat-tool-bridge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node scripts/test-offline.mjs",
    "verify:runtime": "node scripts/patch-runtime.mjs --verify",
    "verify:license": "node scripts/verify-license.mjs",
    "check:offline": "node scripts/verify-source.mjs && node scripts/verify-license.mjs && node scripts/patch-runtime.mjs --verify && node scripts/test-offline.mjs",
    "start:web": "node web-bridge.mjs serve --config bridge.local.json",
    "init:web": "node web-bridge.mjs init --config bridge.local.json",
    "test:universal": "node --test test/universal-*.test.mjs"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "playwright-core": "1.64.1"
  },
  "license": "SEE LICENSE IN LICENSE-SCOPE.md",
  "author": {
    "name": "うんけん"
  }
}
