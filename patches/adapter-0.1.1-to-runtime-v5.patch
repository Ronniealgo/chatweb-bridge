+import { AsyncLocalStorage } from 'node:async_hooks';
+import { randomUUID } from 'node:crypto';
+import { createLogger } from '../log.js';
+const owners = new WeakMap(), queues = new WeakMap(), context = new AsyncLocalStorage();
+const log = createLogger('operation');
+const DEFAULT_QUEUE_LIMIT = 8, DEFAULT_WAIT_MS = 10_000;
+export function operationQueueState(chrome) {
+    return { queued: queues.get(chrome)?.length ?? 0, limit: DEFAULT_QUEUE_LIMIT };
+}
+export function operationState(chrome) {
+    const state = owners.get(chrome);
+    if (!state) return null;
+    return { requestId: state.requestId, kind: state.kind, phase: state.phase, generation_submitted: state.submitted };
+}
+export function traceOperation(chrome, event, details = {}) {
+    log.info(event, { ...operationState(chrome), ...details });
+}
+export function operationPhase(chrome, phase, submitted) {
+    const state = owners.get(chrome);
+    if (!state) return;
+    state.phase = phase;
+    if (submitted !== undefined) state.submitted = submitted;
+    traceOperation(chrome, 'phase');
+}
+function queueError(entry, code, message, status = 429) {
+    return Object.assign(new Error(message), { status, code, requestId: entry.requestId, phase: 'queue', generationSubmitted: false });
+}
+function detach(entry) {
+    clearTimeout(entry.timer);
+    entry.signal?.removeEventListener('abort', entry.onAbort);
+}
+function release(chrome, state) {
