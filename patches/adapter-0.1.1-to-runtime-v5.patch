+        const accessGate = !!document.querySelector('#challenge-running, #challenge-stage, iframe[src*="challenges.cloudflare.com"], iframe[src*="captcha"], input[type="password"]');
+        const gate = loginRequired || accessGate;
+        const pending = document.querySelector('textarea#pending-home-input');
+        for (const selector of (selected ? [selected] : editors)) {
+            const el = document.querySelector(selector);
+            if (!visible(el) || el.id === 'pending-home-input' || el.disabled || el.getAttribute('aria-disabled') === 'true') continue;
+            if (!el.isContentEditable && el.tagName !== 'TEXTAREA') continue;
+            const text = el.value ?? el.textContent ?? '';
+            // Current ChatGPT also renders a composer without a form. Search only a
+            // bounded local ancestor and accept one explicitly labelled send button.
+            const form = el.closest('form');
+            const formButtons = form ? Array.from(form.querySelectorAll(`${send}, button[type="submit"]`)).filter(visible) : [];
+            let button = formButtons.length === 1 ? formButtons[0] : null;
