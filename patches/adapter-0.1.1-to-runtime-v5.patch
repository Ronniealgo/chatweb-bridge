+            slot.result = { ok: response.ok, status: response.status, text, reason: null };
+        } catch {
+            slot.result = { ok: false, status: slot.status, text: '',
+                reason: slot.abortReason ?? (reading ? 'response_read_failed' : 'fetch_failed') };
+        } finally {
