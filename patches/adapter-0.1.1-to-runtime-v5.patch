+// Normal UI preparation only. Never reads session material or manufactures security proofs.
+const EDITORS = ['#prompt-textarea', 'form[data-chatgpt-composer] [contenteditable="true"]', 'form[data-chatgpt-composer] textarea', '[role="textbox"][contenteditable="true"]'];
