+}
+export async function submitComposerOnce(page, prepared) {
+    let clicked;
+    try {
+        clicked = await page.evaluate(inspectComposerDOM, { ...prepared, send: SEND, action: 'submit' });
+    } catch {
+        throw new BrowserPreparationError('The browser connection changed while sending. Submission is uncertain; no automatic replay is permitted.', 'browser_submission_uncertain', 'submit', 'unknown');
